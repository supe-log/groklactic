{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/supe-log/groklactic/intake.schema.json",
  "title": "Groklactic business intake",
  "type": "object",
  "required": ["schema_version", "business_id", "example_data", "business", "tools", "pain_points", "rules"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "business_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "example_data": {"type": "boolean", "description": "true when any field is invented demo data"},
    "example_data_notice": {"type": "string"},
    "business": {
      "type": "object",
      "required": ["display_name", "industry", "timezone", "team_size"],
      "properties": {
        "display_name": {"type": "string"},
        "industry": {"type": "string"},
        "location": {"type": "object", "properties": {"city": {"type": "string"}, "region": {"type": "string"}, "country": {"type": "string"}}},
        "timezone": {"type": "string", "description": "IANA zone"},
        "business_hours": {"type": "object"},
        "team_size": {"type": "integer", "minimum": 1, "maximum": 50},
        "roles": {"type": "array", "items": {"type": "object", "required": ["role", "count"], "properties": {"role": {"type": "string"}, "count": {"type": "integer", "minimum": 0}, "licensed": {"type": "boolean"}}}},
        "lines_of_business": {"type": "array", "items": {"type": "string"}},
        "carrier_count_estimate": {"type": "integer", "minimum": 0}
      }
    },
    "founder": {"type": "object", "properties": {"display_name": {"type": "string"}, "contact_email": {"type": "string"}, "preferred_channel": {"type": "string"}}},
    "tools": {"type": "object", "additionalProperties": {"type": "string"}},
    "pain_points": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "area", "description"], "properties": {"id": {"type": "string"}, "area": {"type": "string"}, "description": {"type": "string"}, "volume_estimate": {"type": "string"}}}},
    "rules": {"type": "object", "required": ["client_messages", "deletes", "routines_start_paused"], "properties": {"routines_start_paused": {"const": true}}, "additionalProperties": {"type": ["string", "boolean"]}},
    "parameters": {"type": "object", "additionalProperties": {"type": ["number", "string", "boolean"]}},
    "goals": {"type": "array", "items": {"type": "string"}}
  }
}
