{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/supe-log/groklactic/plan.schema.json",
  "title": "Groklactic Grok Bot team plan",
  "type": "object",
  "required": ["schema_version", "plan_id", "business_id", "timezone", "global_guardrails", "bots"],
  "properties": {
    "schema_version": {"type": "string"},
    "plan_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
    "business_id": {"type": "string"},
    "generated_at": {"type": "string"},
    "intake_file": {"type": "string"},
    "industry": {"type": "string"},
    "timezone": {"type": "string"},
    "example_data_notice": {"type": "string"},
    "self_contained": {"type": "boolean"},
    "global_guardrails": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "rule"], "properties": {"id": {"type": "string"}, "rule": {"type": "string", "minLength": 10}}}},
    "founder_approval_defaults": {"type": "array", "items": {"type": "string"}},
    "shared_runtime": {"type": "object"},
    "feedback": {"type": "object"},
    "demo_beat": {"type": "array", "items": {"type": "string"}},
    "bots": {"type": "array", "minItems": 1, "maxItems": 6, "items": {"$ref": "#/$defs/bot"}}
  },
  "$defs": {
    "bot": {
      "type": "object",
      "required": ["slug", "name", "title", "description", "instructions", "skills", "routines", "plugins", "approval_rules", "handoffs"],
      "properties": {
        "slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
        "name": {"type": "string", "minLength": 2, "maxLength": 64},
        "title": {"type": "string"},
        "description": {"type": "string", "minLength": 10},
        "instructions_file": {"type": "string"},
        "instructions": {"type": "string", "minLength": 200},
        "skills": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/skill"}},
        "routines": {"type": "array", "items": {"$ref": "#/$defs/routine"}},
        "plugins": {"type": "array", "items": {"$ref": "#/$defs/plugin"}},
        "approval_rules": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/approval_rule"}},
        "handoffs": {"type": "array", "items": {"type": "object", "required": ["to", "when"], "properties": {"to": {"type": "string"}, "when": {"type": "string"}, "payload": {"type": "string"}}}}
      }
    },
    "skill": {"type": "object", "required": ["id", "name", "description", "file"], "properties": {"id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"}, "name": {"type": "string"}, "description": {"type": "string", "minLength": 20}, "file": {"type": "string", "pattern": "SKILL\\.md$"}, "skill_md": {"type": "string", "pattern": "^---\\nname: "}}},
    "routine": {
      "type": "object",
      "required": ["id", "name", "trigger", "timezone", "prompt", "enabled"],
      "properties": {
        "id": {"type": "string"}, "name": {"type": "string"},
        "trigger": {"type": "object", "required": ["type", "schedule"], "properties": {"type": {"const": "cron"}, "schedule": {"type": "string", "pattern": "^(CRON_TZ=[A-Za-z_/]+ )?\\S+ \\S+ \\S+ \\S+ \\S+$"}}},
        "cron_local": {"type": "string"}, "timezone": {"type": "string"},
        "skills_used": {"type": "array", "items": {"type": "string"}},
        "prompt": {"type": "string", "minLength": 20},
        "enabled": {"const": false, "description": "ALL routines ship paused"}
      }
    },
    "plugin": {"type": "object", "required": ["service", "search_query", "plugin_id", "verification"], "properties": {"service": {"type": "string"}, "search_query": {"type": "string"}, "plugin_id": {"type": ["string", "null"]}, "verification": {"enum": ["verified_plugin_id", "connector_observed_unresolved_id", "unverified", "not_available_browser_fallback"]}, "note": {"type": "string"}}},
    "approval_rule": {"type": "object", "required": ["id", "when", "requires", "how"], "properties": {"id": {"type": "string"}, "when": {"type": "string"}, "requires": {"enum": ["founder_approval", "licensed_agent_review"]}, "how": {"type": "string"}}}
  }
}
