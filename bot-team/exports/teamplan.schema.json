{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "eye-of-grok TeamPlan (jsonschema mirror of the zod schema in src/lib/harness-types.ts @ e4d57fc, as relayed)",
  "type": "object",
  "required": ["orgId", "version", "createdAt", "updatedAt", "intake", "chiefOfStaffId", "bots", "groups", "hardRules", "changelog"],
  "properties": {
    "orgId": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 1},
    "createdAt": {"type": "string"},
    "updatedAt": {"type": "string"},
    "intake": {"type": "object", "required": ["businessName", "industry", "teamSize", "tools", "painPoints", "rules"], "properties": {
      "businessName": {"type": "string"}, "industry": {"enum": ["insurance_agency", "small_business"]},
      "teamSize": {"type": "integer", "minimum": 1}, "tools": {"type": "array", "items": {"type": "string"}},
      "painPoints": {"type": "string"}, "rules": {"type": "string"}}},
    "chiefOfStaffId": {"type": "string"},
    "bots": {"type": "array", "minItems": 1, "maxItems": 6, "items": {"type": "object",
      "required": ["id", "name", "title", "description", "rules", "autonomy", "skills", "routines"],
      "properties": {
        "id": {"type": "string"}, "name": {"type": "string"}, "title": {"type": "string"}, "description": {"type": "string"},
        "rules": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "autonomy": {"enum": ["draft_only", "ask_first", "autonomous"]},
        "skills": {"type": "array", "items": {"type": "object", "required": ["name", "description", "content"], "properties": {"name": {"type": "string"}, "description": {"type": "string"}, "content": {"type": "string"}}}},
        "routines": {"type": "array", "items": {"type": "object", "required": ["name", "slug", "schedule", "prompt", "enabled"], "properties": {"name": {"type": "string"}, "slug": {"type": "string"}, "schedule": {"type": "string"}, "prompt": {"type": "string"}, "enabled": {"const": false}}}}}}},
    "groups": {"type": "array", "items": {"type": "object", "required": ["id", "name", "purpose", "memberIds"], "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "purpose": {"type": "string"}, "memberIds": {"type": "array", "minItems": 2, "maxItems": 6, "items": {"type": "string"}}}}},
    "hardRules": {"type": "array", "items": {"type": "string"}},
    "changelog": {"type": "array"}
  }
}
